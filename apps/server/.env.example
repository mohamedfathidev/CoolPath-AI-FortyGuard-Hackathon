FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
GEMINI_API_KEY=
# gemini-2.5-flash is no longer available to new API keys. gemini-3.7-flash's free tier
# has a very tight (~20 req/min) quota; gemini-3.6-flash worked reliably in testing.
GEMINI_MODEL=gemini-3.6-flash
# Optional automatic fallback used when Gemini exhausts its retries (e.g. quota exceeded).
# Leave blank to disable — the app still works, it just surfaces the Gemini error instead.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
PORT=8787
# Postgres connection string, e.g. from Neon (free tier, no card required): https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
